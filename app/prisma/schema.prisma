// Private Office — Prisma Schema
// Basado en: MD-300 (Canonical Data Model), DM-001 (Canonical Entities),
// FS-003 (Group/Ownership), FS-004 (Parties), FS-005 (Identity/Roles), FS-017 (Calendar/Alerts).
//
// v1: modela lo mínimo necesario para las FS ya cerradas.
// No incluye todavía: Treasury (FS-006), Vault metadata (FS-016), Timeline (FS-002).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CORE — Entidades legales y perfil personal (MD-200, FS-003)
// ---------------------------------------------------------------------------

enum EntityType {
  LEGAL_ENTITY // ej: Axentia EAS, Casa Amelia EAS
  PERSONAL_PROFILE // ej: RUC personal de Ronald
}

enum CompanyType {
  PERSONAL_SERVICE // Servicios personales (RUC personal — consultoría, etc.)
  EVENT_SERVICES // Servicios de eventos (Casa Amelia — alquileres, catering, etc.)
  CONSULTING // Consultoría empresarial, administración, finanzas (Axentia)
}

model Entity {
  id           String      @id @default(uuid())
  name         String // ej: "Axentia EAS"
  type         EntityType
  companyType  CompanyType? // PERSONAL_SERVICE | EVENT_SERVICES | CONSULTING
  taxId        String? // RUC — puede ser un placeholder genérico mientras status = pending_incorporation
  jurisdiction String? // ej: "Paraguay"
  baseCurrency String? // ISO 4217, ej: "PYG"
  address      String? // dirección legal/fiscal — puede ser genérica hasta confirmar con la constitución
  phone        String? // contacto genérico hasta confirmar dato real
  email        String? // contacto genérico hasta confirmar dato real
  // Identificador visual estable para esta entidad (ej: "cat-1".."cat-9"),
  // usado en el dashboard para marcar qué empresa comparte un mismo
  // vencimiento tributario de un vistazo. Token, no un hex directo, para que
  // el color se resuelva vía CSS y respete dark mode (ver globals.css).
  colorToken   String?
  status       String      @default("active") // active | pending_incorporation | suspended | closed (MD-300 invariant: nunca se borra)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userAccess   UserAccess[]
  partyLinks   PartyEntityLink[]
  obligations  Obligation[]
  documentLinks    DocumentEntityLink[]
  ownedInterests   OwnershipInterest[] @relation("OwnerOf") // participaciones que ESTA entidad posee en otras
  interestsHeldBy  OwnershipInterest[] @relation("OwnedBy") // participaciones que otros poseen SOBRE esta entidad
  accounts     Account[] @relation("EntityAccounts")
  projects     Project[] @relation("EntityProjects")
  timelineEvents TimelineEvent[] @relation("EntityTimelineEvents")
  intelligenceReports IntelligenceReport[] @relation("EntityIntelligence")
  customers    Customer[] @relation("EntityCustomers")
  products     Product[] @relation("EntityProducts")
  suppliers    Supplier[] @relation("EntitySuppliers")
  inventory    InventoryItem[] @relation("EntityInventory")
  quotes       Quote[] @relation("EntityQuotes")
  invoices     Invoice[] @relation("EntityInvoices")
  events       Event[] @relation("EntityEvents")
  accountingReports AccountingReport[] @relation("EntityAccountingReports")

  @@map("entities")
}

// ---------------------------------------------------------------------------
// IDENTITY, ROLES & ACCESS (FS-005)
// El usuario real (login, MFA) vive en Clerk. Acá solo guardamos el vínculo:
// qué clerkUserId tiene qué rol en qué Entity. Es la fuente de autorización
// que la API consulta en cada request — nunca se confía solo en Clerk.
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMINISTRADOR_HOLDING // administra un holding y, por cascada, todas sus subsidiarias (ver UserAccess.cascadesToSubsidiaries)
  SOCIO_OPERATIVO // socio con responsabilidad operativa en una o más empresas (ej: Alexis de Kermenguy), distinto de un GERENTE contratado
  GERENTE
  CONTADOR
  ASISTENTE
}

model UserAccess {
  id          String   @id @default(uuid())
  clerkUserId String // id de usuario que da Clerk
  role        Role
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  // Si es true y `entity` es un holding, este acceso se extiende automáticamente
  // a toda empresa donde `entity` figure como owner en OwnershipInterest — sin
  // necesidad de crear un UserAccess por cada subsidiaria nueva. Ver lib/access.ts
  // y ADR-007 (Cascading Holding Access). Un solo nivel por ahora (no recursivo).
  cascadesToSubsidiaries Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Auditoría de cambios de acceso (regla FS-005 / DM-002)
  accessChanges AccessChangeLog[]

  @@unique([clerkUserId, entityId]) // un usuario tiene un solo rol por entidad
  @@map("user_access")
}

model AccessChangeLog {
  id           String     @id @default(uuid())
  userAccessId String
  userAccess   UserAccess @relation(fields: [userAccessId], references: [id])
  changedBy    String // clerkUserId de quien hizo el cambio (siempre debería ser el Owner)
  changeType   String // "created" | "role_changed" | "revoked"
  beforeState  String? // snapshot simple en texto/JSON
  afterState   String?
  occurredAt   DateTime   @default(now())

  @@map("access_change_log")
}

// ---------------------------------------------------------------------------
// PARTIES & RELATIONSHIPS (FS-004) — contactos externos sin login
// ---------------------------------------------------------------------------

enum RelationshipType {
  SUPPLIER
  CLIENT
  EXTERNAL_PARTNER
  ATTORNEY
  BANK
  FAMILY_MEMBER
  OTHER
}

model Party {
  id               String           @id @default(uuid())
  fullName         String
  taxId            String? // cédula o RUC
  phone            String?
  email            String?
  address          String?
  relationshipType RelationshipType
  status           String           @default("active") // active | archived (nunca se borra si tiene vínculos)
  // Si este Party recibe acceso al sistema (ej: Alexis de Kermenguy pasa a
  // tener login), se vincula acá su clerkUserId — así el sistema puede resolver
  // "mi propia propiedad" vía ownedInterests sin duplicar su identidad como
  // un segundo registro. Null mientras el contacto no tenga login (caso normal
  // de la mayoría de los Party: proveedores, bancos, etc.).
  clerkUserId      String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  bankingDetails   PartyBankingDetails?
  entityLinks      PartyEntityLink[]
  ownedInterests   OwnershipInterest[] @relation("PartyOwnerOf") // participaciones que este Party posee sobre entidades del Grupo (DM-001: Party puede jugar rol "owner")

  @@map("parties")
}

// Datos bancarios separados: clasificación Restricted (SEC-001) —
// se consulta aparte, nunca viene incluido en una consulta general de Party.
model PartyBankingDetails {
  id            String   @id @default(uuid())
  partyId       String   @unique
  party         Party    @relation(fields: [partyId], references: [id])
  bankName      String?
  accountNumber String?
  accountType   String?
  updatedAt     DateTime @updatedAt

  @@map("party_banking_details")
}

// Un Party puede estar vinculado a varias Entity a la vez (regla FS-004)
model PartyEntityLink {
  id        String   @id @default(uuid())
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id])
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  createdAt DateTime @default(now())

  @@unique([partyId, entityId])
  @@map("party_entity_links")
}

// ---------------------------------------------------------------------------
// CALENDAR, TASKS & ALERTS (FS-017) — obligaciones tributarias
// ---------------------------------------------------------------------------

model Obligation {
  id         String    @id @default(uuid())
  entityId   String
  entity     Entity    @relation(fields: [entityId], references: [id])
  code       String // ej: "211", "700", "954"
  name       String // ej: "IVA General"
  activeSince DateTime // fecha de alta ante la SET, NO es vencimiento
  createdAt  DateTime  @default(now())

  dueRule    ObligationDueRule?

  @@unique([entityId, code])
  @@map("obligations")
}

// Regla de vencimiento recurrente — SEPARADA del registro de la obligación.
// confirmed = false significa "vencimiento sin confirmar" (regla AI-001:
// nunca se calcula ni se asume, se muestra como pendiente).
model ObligationDueRule {
  id           String     @id @default(uuid())
  obligationId String     @unique
  obligation   Obligation @relation(fields: [obligationId], references: [id])
  ruleText     String? // ej: "Día 8 de cada mes" / "8 de abril, anual"
  confirmed    Boolean    @default(false)
  confirmedBy  String? // "owner" | "contador" | nombre de quien confirmó
  updatedAt    DateTime   @updatedAt

  @@map("obligation_due_rules")
}

// ---------------------------------------------------------------------------
// GROUP, COMPANIES & OWNERSHIP (FS-003) — participaciones fechadas
// ---------------------------------------------------------------------------

model OwnershipInterest {
  id                String    @id @default(uuid())

  // El owner de una participación puede ser una Entity del Grupo (otra
  // empresa, o el perfil personal de Ronald) O un Party externo (ej: un
  // socio persona física sin login, como Alexis de Kermenguy). Exactamente
  // uno de los dos debe estar poblado — no hay constraint de base de datos
  // para esto todavía (se usa `db push`, sin migraciones formales); se
  // valida a nivel de aplicación/seed. Base: DM-001 (Party puede jugar rol
  // "owner") + FS-003.
  ownerId           String?
  owner             Entity?   @relation("OwnerOf", fields: [ownerId], references: [id])
  ownerPartyId      String?
  ownerParty        Party?    @relation("PartyOwnerOf", fields: [ownerPartyId], references: [id])

  subjectEntityId   String // sobre qué entidad es la participación
  subjectEntity     Entity    @relation("OwnedBy", fields: [subjectEntityId], references: [id])
  interestType      String    @default("equity") // equity | economic_rights | voting_control
  percentage        Decimal?  @db.Decimal(5, 2) // nullable: puede ser desconocido (regla FS-003)
  effectiveFrom     DateTime
  effectiveTo       DateTime? // null = vigente
  sourceDocument    String? // referencia al documento que respalda el dato
  verificationState String    @default("unverified") // unverified | verified
  approvedBy        String? // quién verificó/aprobó el dato
  notes             String? // ej: "pendiente cierre documental del 50% restante"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("ownership_interests")
}

// ---------------------------------------------------------------------------
// VAULT — Documentos (FS-016)
// v1 MVP: el archivo se guarda en disco local del servidor, fuera de
// /public, servido solo por una ruta autenticada (app/api/vault/[id]/route.ts)
// que revisa acceso con lib/access.ts antes de entregar bytes. Esto es un
// placeholder de almacenamiento para poder probar el sistema de punta a
// punta hoy mismo — MD-500 deja pendiente la decisión de object storage
// real (S3/R2/etc.) vía ADR. Cuando se decida, `storagePath` pasa a ser una
// key de ese storage en vez de una ruta de filesystem; el resto del modelo
// (hash, versionado, clasificación, vínculos) no cambia.
// ---------------------------------------------------------------------------

enum DocumentClassification {
  RESTRICTED // identidad, bancario, ownership, tax, credenciales (SEC-001)
  CONFIDENTIAL // contratos, facturas, reportes internos, datos de proyecto
  INTERNAL // procedimientos operativos, plantillas aprobadas
  PUBLIC // material externo explícitamente aprobado para publicar
}

model Document {
  id             String                 @id @default(uuid())
  title          String
  filename       String // nombre original del archivo subido
  mimeType       String
  sizeBytes      Int
  contentHash    String // sha256 del binario original (FS-016: preservar procedencia)
  storagePath    String // ruta relativa dentro del storage local (MVP)
  classification DocumentClassification @default(CONFIDENTIAL)
  // Versionado simple: una versión nueva es un Document nuevo que reemplaza
  // al anterior — el original nunca se edita ni se borra (regla FS-016:
  // "crear versiones inmutables en vez de sobrescribir").
  supersedesId   String?                @unique
  supersedes     Document?              @relation("DocumentVersions", fields: [supersedesId], references: [id])
  supersededBy   Document?              @relation("DocumentVersions")
  uploadedBy     String // clerkUserId de quien subió el archivo
  createdAt      DateTime               @default(now())

  entityLinks    DocumentEntityLink[]
  accessLog      DocumentAccessLog[]

  @@map("documents")
}

// Un documento puede estar relacionado a más de una entidad a la vez
// (ej: un contrato entre dos empresas del Grupo). FS-016.
model DocumentEntityLink {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([documentId, entityId])
  @@map("document_entity_links")
}

// Auditoría de descargas/previsualizaciones (regla FS-016 / SEC-002: toda
// lectura de un documento sensible queda registrada).
model DocumentAccessLog {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  accessedBy String // clerkUserId
  action     String // "download" | "preview" | "upload"
  occurredAt DateTime @default(now())

  @@map("document_access_log")
}

// ---------------------------------------------------------------------------
// TREASURY (FS-006) — Cuentas bancarias, saldos, movimientos
// ---------------------------------------------------------------------------

model Account {
  id            String    @id @default(uuid())
  entityId      String
  entity        Entity    @relation("EntityAccounts", fields: [entityId], references: [id])

  // Datos del cuenta
  accountNumber String? // número de cuenta (parcialmente mascarado para seguridad)
  accountName   String? // ej: "Cuenta corriente principal"
  accountType   String? // checking | savings | investment | cash | other
  provider      String? // nombre del banco/entidad financiera
  currency      String  @default("PYG") // ISO 4217

  // Estado
  status        String  @default("active") // active | closed | suspended

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  balances      AccountBalance[]
  movements     AccountMovement[]

  @@unique([entityId, accountNumber])
  @@map("financial_accounts")
}

// Saldo actual de la cuenta — importado o calculado
model AccountBalance {
  id        String    @id @default(uuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id])

  // Balance importado de la fuente (banco, etc.)
  amount    Decimal   @db.Decimal(18, 2)
  asOfDate  DateTime  // fecha a la que corresponde este saldo

  // Origen del dato
  source    String    @default("manual") // manual | import | calculated
  importedBy String?  // clerkUserId si fue importado manualmente

  createdAt DateTime  @default(now())

  @@map("financial_account_balances")
}

// Movimientos contables (transacciones)
model AccountMovement {
  id          String    @id @default(uuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])

  description String?
  amount      Decimal   @db.Decimal(18, 2)
  direction   String    // in | out

  transactionDate DateTime // fecha en que ocurrió el movimiento
  importedAt  DateTime @default(now())

  classification String? // categoría o tipo de movimiento (ej: "transfer", "fee", "salary")

  @@map("account_movements")
}

// ---------------------------------------------------------------------------
// TASK MANAGEMENT (FS-013) — Proyectos y tareas
// ---------------------------------------------------------------------------

model Project {
  id          String    @id @default(uuid())
  entityId    String
  entity      Entity    @relation("EntityProjects", fields: [entityId], references: [id])

  title       String
  description String?
  status      String    @default("active") // active | archived | completed
  createdBy   String    // clerkUserId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       Task[]

  @@map("projects")
}

model Task {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      String    @default("open") // open | in_progress | completed | closed
  priority    String    @default("medium") // low | medium | high | urgent

  assignedTo  String? // clerkUserId (puede estar sin asignar)
  dueDate     DateTime?

  createdBy   String    // clerkUserId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    TaskComment[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  content   String
  author    String   // clerkUserId
  createdAt DateTime @default(now())

  @@map("task_comments")
}

// ---------------------------------------------------------------------------
// TIMELINE EVENTS (FS-002 completo) — Auditoría de cambios
// ---------------------------------------------------------------------------

model TimelineEvent {
  id          String   @id @default(uuid())
  entityId    String?  // nullable: algunos eventos son globales
  entity      Entity?  @relation("EntityTimelineEvents", fields: [entityId], references: [id])

  eventType   String   // entity_created, document_uploaded, task_created, task_updated, obligation_confirmed, etc.
  description String

  // Quién hizo el cambio
  changedBy   String   // clerkUserId

  // Cambios anteriores/nuevos (JSON para flexibilidad)
  changes     String?  // JSON serializado (antes/después de propiedades)

  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
  @@map("timeline_events")
}

// ---------------------------------------------------------------------------
// INTELLIGENCE (FS-019) — Análisis y predicciones con Claude AI
// ---------------------------------------------------------------------------

model IntelligenceReport {
  id          String   @id @default(uuid())
  entityId    String
  entity      Entity   @relation("EntityIntelligence", fields: [entityId], references: [id])

  reportType  String   // treasury_forecast | project_risk | obligation_alert | cash_flow | etc.
  title       String
  summary     String   // breve resumen ejecutivo

  // Análisis completo (puede ser HTML, Markdown, JSON)
  content     String   @db.Text
  contentType String   @default("markdown") // markdown | html | json

  confidence  Int?     // 0-100: nivel de confianza del análisis

  requestedBy String   // clerkUserId
  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([reportType])
  @@index([createdAt])
  @@map("intelligence_reports")
}

// ---------------------------------------------------------------------------
// SALES & OPERATIONS — Clientes, Productos, Cotizaciones, Facturas
// ---------------------------------------------------------------------------

model Customer {
  id              String   @id @default(uuid())
  entityId        String
  entity          Entity   @relation("EntityCustomers", fields: [entityId], references: [id])

  fullName        String
  businessName    String?  // razón social si es empresa
  taxId           String?  // RUC/cédula
  phone           String?
  email           String?
  address         String?
  city            String?
  country         String?

  // Clasificación
  customerType    String   @default("individual") // individual | business
  status          String   @default("active") // active | inactive | archived

  // Límite de crédito
  creditLimit     Decimal? @db.Decimal(18, 2)
  creditUsed      Decimal  @default(0) @db.Decimal(18, 2)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices        Invoice[]
  quotes          Quote[]

  @@unique([entityId, taxId])
  @@map("customers")
}

model Supplier {
  id              String   @id @default(uuid())
  entityId        String
  entity          Entity   @relation("EntitySuppliers", fields: [entityId], references: [id])

  fullName        String
  businessName    String?  // razón social si es empresa
  taxId           String?  // RUC/cédula
  phone           String?
  email           String?
  address         String?
  city            String?
  country         String?

  // Clasificación
  supplierType    String   @default("individual") // individual | business
  status          String   @default("active") // active | inactive | archived

  // Términos de pago
  paymentTerms    String?  // ej: "30 días"
  bankAccount     String?  // datos bancarios del proveedor

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseInvoices Invoice[] @relation("purchaseInvoices")

  @@unique([entityId, taxId])
  @@map("suppliers")
}

enum ProductType {
  PRODUCT  // producto físico (mesas, sillas, bebidas, etc.)
  SERVICE  // servicio (catering, sonido, iluminación, etc.)
}

model Product {
  id              String      @id @default(uuid())
  entityId        String
  entity          Entity      @relation("EntityProducts", fields: [entityId], references: [id])

  code            String      // código interno del producto
  name            String
  description     String?
  category        String?
  productType     ProductType @default(PRODUCT) // PRODUCT | SERVICE

  // Precios
  unitPrice       Decimal     @db.Decimal(18, 2) // precio unitario
  cost            Decimal?    @db.Decimal(18, 2) // costo interno
  currency        String      @default("PYG")

  // Inventario (principalmente para PRODUCT en Amelia)
  quantity        Int         @default(0)
  unit            String      @default("unidad") // unidad, kg, litro, etc.

  // Fiscal
  taxRate         Decimal     @default(10) @db.Decimal(5, 2) // IVA %

  status          String      @default("active") // active | discontinued | archived
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  quoteItems      QuoteItem[]
  invoiceItems    InvoiceItem[]
  inventoryItems  InventoryItem[]

  @@unique([entityId, code])
  @@map("products")
}

model Quote {
  id              String   @id @default(uuid())
  entityId        String
  entity          Entity   @relation("EntityQuotes", fields: [entityId], references: [id])
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])

  quoteNumber     String
  description     String?
  status          String   @default("draft") // draft | sent | accepted | rejected | expired

  // Montos
  subtotal        Decimal  @db.Decimal(18, 2)
  taxAmount       Decimal  @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)
  currency        String   @default("PYG")

  // Validez
  issueDate       DateTime
  expiryDate      DateTime
  notes           String?

  createdBy       String   // clerkUserId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           QuoteItem[]

  @@unique([entityId, quoteNumber])
  @@map("quotes")
}

model QuoteItem {
  id              String   @id @default(uuid())
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  quantity        Decimal  @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 2)
  taxRate         Decimal  @db.Decimal(5, 2)
  total           Decimal  @db.Decimal(18, 2)

  @@map("quote_items")
}

enum InvoiceType {
  SALE      // factura de venta
  PURCHASE  // factura de compra
}

model Invoice {
  id              String        @id @default(uuid())
  entityId        String
  entity          Entity        @relation("EntityInvoices", fields: [entityId], references: [id])
  customerId      String?       // para facturas de VENTA
  customer        Customer?     @relation(fields: [customerId], references: [id])
  supplierId      String?       // para facturas de COMPRA
  supplier        Supplier?     @relation("purchaseInvoices", fields: [supplierId], references: [id])

  invoiceNumber   String
  invoiceType     InvoiceType   // SALE | PURCHASE
  status          String        @default("draft") // draft | issued | paid | cancelled

  // Montos
  subtotal        Decimal       @db.Decimal(18, 2)
  taxAmount       Decimal       @db.Decimal(18, 2)
  total           Decimal       @db.Decimal(18, 2)
  currency        String        @default("PYG")

  // Dates
  issueDate       DateTime
  dueDate         DateTime?
  paidDate        DateTime?

  // Referencia
  quoteId         String?       // si fue generada de una cotización
  notes           String?

  createdBy       String        // clerkUserId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]
  payments        Payment[]

  @@unique([entityId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  quantity        Decimal  @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 2)
  taxRate         Decimal  @db.Decimal(5, 2)
  total           Decimal  @db.Decimal(18, 2)

  @@map("invoice_items")
}

model Payment {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount          Decimal  @db.Decimal(18, 2)
  paymentDate     DateTime
  paymentMethod   String   // cash | bank_transfer | check | card | other
  reference       String?  // número de cheque, ref de transferencia, etc.

  createdBy       String   // clerkUserId
  createdAt       DateTime @default(now())

  @@map("payments")
}

// ---------------------------------------------------------------------------
// EVENTS — Calendarios y eventos (Casa Amelia, etc.)
// ---------------------------------------------------------------------------

model Event {
  id              String   @id @default(uuid())
  entityId        String
  entity          Entity   @relation("EntityEvents", fields: [entityId], references: [id])

  title           String
  description     String?
  eventType       String   // event | reminder | alert | task

  startDate       DateTime
  endDate         DateTime?
  location        String?

  attendees       String?  // JSON array de clerkUserIds o emails

  status          String   @default("scheduled") // scheduled | completed | cancelled

  createdBy       String   // clerkUserId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entityId])
  @@index([startDate])
  @@map("events")
}

// ---------------------------------------------------------------------------
// INVENTORY — Stock de productos (Casa Amelia)
// ---------------------------------------------------------------------------

model InventoryItem {
  id              String   @id @default(uuid())
  entityId        String
  entity          Entity   @relation("EntityInventory", fields: [entityId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Stock actual
  quantity        Decimal  @db.Decimal(18, 4)
  location        String?  // ej: "Almacén A", "Mesa de catering", etc.
  status          String   @default("available") // available | in_use | damaged | archived

  // Auditoría
  lastStockCheck  DateTime?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityId, productId])
  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// ACCOUNTING REPORTS — Reportes contables para el contador
// ---------------------------------------------------------------------------

model AccountingReport {
  id              String   @id @default(uuid())
  entityId        String
  entity          Entity   @relation("EntityAccountingReports", fields: [entityId], references: [id])

  reportType      String   // balance_sheet | income_statement | cash_flow | trial_balance | journal
  period          String   // YYYY-MM (ej: 2026-08)
  status          String   @default("draft") // draft | submitted | accepted | archived

  // Contenido del reporte
  content         String   @db.Text // JSON con datos del reporte
  htmlContent     String?  @db.Text // versión HTML para imprimir

  // Auditoría
  createdBy       String   // clerkUserId del usuario
  submittedTo     String?  // email o identificador del contador
  submittedAt     DateTime?
  approvedBy      String?  // contador que aprobó
  approvedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityId, reportType, period])
  @@index([entityId])
  @@index([period])
  @@map("accounting_reports")
}

