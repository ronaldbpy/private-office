// Private Office — Prisma Schema
// Basado en: MD-300 (Canonical Data Model), DM-001 (Canonical Entities),
// FS-003 (Group/Ownership), FS-004 (Parties), FS-005 (Identity/Roles), FS-017 (Calendar/Alerts).
//
// v1: modela lo mínimo necesario para las FS ya cerradas.
// No incluye todavía: Treasury (FS-006), Vault metadata (FS-016), Timeline (FS-002).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CORE — Entidades legales y perfil personal (MD-200, FS-003)
// ---------------------------------------------------------------------------

enum EntityType {
  LEGAL_ENTITY // ej: Axentia EAS, Casa Amelia EAS
  PERSONAL_PROFILE // ej: RUC personal de Ronald
}

model Entity {
  id           String     @id @default(uuid())
  name         String // ej: "Axentia EAS"
  type         EntityType
  taxId        String? // RUC — puede ser un placeholder genérico mientras status = pending_incorporation
  jurisdiction String? // ej: "Paraguay"
  baseCurrency String? // ISO 4217, ej: "PYG"
  address      String? // dirección legal/fiscal — puede ser genérica hasta confirmar con la constitución
  phone        String? // contacto genérico hasta confirmar dato real
  email        String? // contacto genérico hasta confirmar dato real
  status       String     @default("active") // active | pending_incorporation | suspended | closed (MD-300 invariant: nunca se borra)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userAccess   UserAccess[]
  partyLinks   PartyEntityLink[]
  obligations  Obligation[]
  documentLinks    DocumentEntityLink[]
  ownedInterests   OwnershipInterest[] @relation("OwnerOf") // participaciones que ESTA entidad posee en otras
  interestsHeldBy  OwnershipInterest[] @relation("OwnedBy") // participaciones que otros poseen SOBRE esta entidad

  @@map("entities")
}

// ---------------------------------------------------------------------------
// IDENTITY, ROLES & ACCESS (FS-005)
// El usuario real (login, MFA) vive en Clerk. Acá solo guardamos el vínculo:
// qué clerkUserId tiene qué rol en qué Entity. Es la fuente de autorización
// que la API consulta en cada request — nunca se confía solo en Clerk.
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMINISTRADOR_HOLDING // administra un holding y, por cascada, todas sus subsidiarias (ver UserAccess.cascadesToSubsidiaries)
  SOCIO_OPERATIVO // socio con responsabilidad operativa en una o más empresas (ej: Alexis de Kermenguy), distinto de un GERENTE contratado
  GERENTE
  CONTADOR
  ASISTENTE
}

model UserAccess {
  id          String   @id @default(uuid())
  clerkUserId String // id de usuario que da Clerk
  role        Role
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  // Si es true y `entity` es un holding, este acceso se extiende automáticamente
  // a toda empresa donde `entity` figure como owner en OwnershipInterest — sin
  // necesidad de crear un UserAccess por cada subsidiaria nueva. Ver lib/access.ts
  // y ADR-007 (Cascading Holding Access). Un solo nivel por ahora (no recursivo).
  cascadesToSubsidiaries Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Auditoría de cambios de acceso (regla FS-005 / DM-002)
  accessChanges AccessChangeLog[]

  @@unique([clerkUserId, entityId]) // un usuario tiene un solo rol por entidad
  @@map("user_access")
}

model AccessChangeLog {
  id           String     @id @default(uuid())
  userAccessId String
  userAccess   UserAccess @relation(fields: [userAccessId], references: [id])
  changedBy    String // clerkUserId de quien hizo el cambio (siempre debería ser el Owner)
  changeType   String // "created" | "role_changed" | "revoked"
  beforeState  String? // snapshot simple en texto/JSON
  afterState   String?
  occurredAt   DateTime   @default(now())

  @@map("access_change_log")
}

// ---------------------------------------------------------------------------
// PARTIES & RELATIONSHIPS (FS-004) — contactos externos sin login
// ---------------------------------------------------------------------------

enum RelationshipType {
  SUPPLIER
  CLIENT
  EXTERNAL_PARTNER
  ATTORNEY
  BANK
  FAMILY_MEMBER
  OTHER
}

model Party {
  id               String           @id @default(uuid())
  fullName         String
  taxId            String? // cédula o RUC
  phone            String?
  email            String?
  address          String?
  relationshipType RelationshipType
  status           String           @default("active") // active | archived (nunca se borra si tiene vínculos)
  // Si este Party recibe acceso al sistema (ej: Alexis de Kermenguy pasa a
  // tener login), se vincula acá su clerkUserId — así el sistema puede resolver
  // "mi propia propiedad" vía ownedInterests sin duplicar su identidad como
  // un segundo registro. Null mientras el contacto no tenga login (caso normal
  // de la mayoría de los Party: proveedores, bancos, etc.).
  clerkUserId      String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  bankingDetails   PartyBankingDetails?
  entityLinks      PartyEntityLink[]
  ownedInterests   OwnershipInterest[] @relation("PartyOwnerOf") // participaciones que este Party posee sobre entidades del Grupo (DM-001: Party puede jugar rol "owner")

  @@map("parties")
}

// Datos bancarios separados: clasificación Restricted (SEC-001) —
// se consulta aparte, nunca viene incluido en una consulta general de Party.
model PartyBankingDetails {
  id            String   @id @default(uuid())
  partyId       String   @unique
  party         Party    @relation(fields: [partyId], references: [id])
  bankName      String?
  accountNumber String?
  accountType   String?
  updatedAt     DateTime @updatedAt

  @@map("party_banking_details")
}

// Un Party puede estar vinculado a varias Entity a la vez (regla FS-004)
model PartyEntityLink {
  id        String   @id @default(uuid())
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id])
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  createdAt DateTime @default(now())

  @@unique([partyId, entityId])
  @@map("party_entity_links")
}

// ---------------------------------------------------------------------------
// CALENDAR, TASKS & ALERTS (FS-017) — obligaciones tributarias
// ---------------------------------------------------------------------------

model Obligation {
  id         String    @id @default(uuid())
  entityId   String
  entity     Entity    @relation(fields: [entityId], references: [id])
  code       String // ej: "211", "700", "954"
  name       String // ej: "IVA General"
  activeSince DateTime // fecha de alta ante la SET, NO es vencimiento
  createdAt  DateTime  @default(now())

  dueRule    ObligationDueRule?

  @@unique([entityId, code])
  @@map("obligations")
}

// Regla de vencimiento recurrente — SEPARADA del registro de la obligación.
// confirmed = false significa "vencimiento sin confirmar" (regla AI-001:
// nunca se calcula ni se asume, se muestra como pendiente).
model ObligationDueRule {
  id           String     @id @default(uuid())
  obligationId String     @unique
  obligation   Obligation @relation(fields: [obligationId], references: [id])
  ruleText     String? // ej: "Día 8 de cada mes" / "8 de abril, anual"
  confirmed    Boolean    @default(false)
  confirmedBy  String? // "owner" | "contador" | nombre de quien confirmó
  updatedAt    DateTime   @updatedAt

  @@map("obligation_due_rules")
}

// ---------------------------------------------------------------------------
// GROUP, COMPANIES & OWNERSHIP (FS-003) — participaciones fechadas
// ---------------------------------------------------------------------------

model OwnershipInterest {
  id                String    @id @default(uuid())

  // El owner de una participación puede ser una Entity del Grupo (otra
  // empresa, o el perfil personal de Ronald) O un Party externo (ej: un
  // socio persona física sin login, como Alexis de Kermenguy). Exactamente
  // uno de los dos debe estar poblado — no hay constraint de base de datos
  // para esto todavía (se usa `db push`, sin migraciones formales); se
  // valida a nivel de aplicación/seed. Base: DM-001 (Party puede jugar rol
  // "owner") + FS-003.
  ownerId           String?
  owner             Entity?   @relation("OwnerOf", fields: [ownerId], references: [id])
  ownerPartyId      String?
  ownerParty        Party?    @relation("PartyOwnerOf", fields: [ownerPartyId], references: [id])

  subjectEntityId   String // sobre qué entidad es la participación
  subjectEntity     Entity    @relation("OwnedBy", fields: [subjectEntityId], references: [id])
  interestType      String    @default("equity") // equity | economic_rights | voting_control
  percentage        Decimal?  @db.Decimal(5, 2) // nullable: puede ser desconocido (regla FS-003)
  effectiveFrom     DateTime
  effectiveTo       DateTime? // null = vigente
  sourceDocument    String? // referencia al documento que respalda el dato
  verificationState String    @default("unverified") // unverified | verified
  approvedBy        String? // quién verificó/aprobó el dato
  notes             String? // ej: "pendiente cierre documental del 50% restante"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("ownership_interests")
}

// ---------------------------------------------------------------------------
// VAULT — Documentos (FS-016)
// v1 MVP: el archivo se guarda en disco local del servidor, fuera de
// /public, servido solo por una ruta autenticada (app/api/vault/[id]/route.ts)
// que revisa acceso con lib/access.ts antes de entregar bytes. Esto es un
// placeholder de almacenamiento para poder probar el sistema de punta a
// punta hoy mismo — MD-500 deja pendiente la decisión de object storage
// real (S3/R2/etc.) vía ADR. Cuando se decida, `storagePath` pasa a ser una
// key de ese storage en vez de una ruta de filesystem; el resto del modelo
// (hash, versionado, clasificación, vínculos) no cambia.
// ---------------------------------------------------------------------------

enum DocumentClassification {
  RESTRICTED // identidad, bancario, ownership, tax, credenciales (SEC-001)
  CONFIDENTIAL // contratos, facturas, reportes internos, datos de proyecto
  INTERNAL // procedimientos operativos, plantillas aprobadas
  PUBLIC // material externo explícitamente aprobado para publicar
}

model Document {
  id             String                 @id @default(uuid())
  title          String
  filename       String // nombre original del archivo subido
  mimeType       String
  sizeBytes      Int
  contentHash    String // sha256 del binario original (FS-016: preservar procedencia)
  storagePath    String // ruta relativa dentro del storage local (MVP)
  classification DocumentClassification @default(CONFIDENTIAL)
  // Versionado simple: una versión nueva es un Document nuevo que reemplaza
  // al anterior — el original nunca se edita ni se borra (regla FS-016:
  // "crear versiones inmutables en vez de sobrescribir").
  supersedesId   String?                @unique
  supersedes     Document?              @relation("DocumentVersions", fields: [supersedesId], references: [id])
  supersededBy   Document?              @relation("DocumentVersions")
  uploadedBy     String // clerkUserId de quien subió el archivo
  createdAt      DateTime               @default(now())

  entityLinks    DocumentEntityLink[]
  accessLog      DocumentAccessLog[]

  @@map("documents")
}

// Un documento puede estar relacionado a más de una entidad a la vez
// (ej: un contrato entre dos empresas del Grupo). FS-016.
model DocumentEntityLink {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([documentId, entityId])
  @@map("document_entity_links")
}

// Auditoría de descargas/previsualizaciones (regla FS-016 / SEC-002: toda
// lectura de un documento sensible queda registrada).
model DocumentAccessLog {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  accessedBy String // clerkUserId
  action     String // "download" | "preview" | "upload"
  occurredAt DateTime @default(now())

  @@map("document_access_log")
}
